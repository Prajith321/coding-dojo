{
  "version": 2,
  "routes": [
    {
      "src": "/api/health/db",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
